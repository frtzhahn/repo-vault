<Window x:Class="RepoVault.Desktop.Views.GrantPeerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grant Peer Viewer Access"
        Width="450"
        Height="310"
        MinWidth="390"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
            <StackPanel>
                <TextBlock Text="Grant Peer Viewer Access"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Peer Viewers can inspect repository metadata, README.md, and post discussion comments, while source code files and git clone remain protected."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,14" />

                <TextBlock Text="Classmate Student"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ComboBox x:Name="CboStudents"
                          Margin="0,0,0,12" />

                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource AccentDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LblError"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            Width="90"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click" />
                    <Button x:Name="BtnGrant"
                            Content="Grant Peer Access"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="135"
                            IsDefault="True"
                            Click="BtnGrant_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
