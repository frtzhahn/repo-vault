<Window x:Class="RepoVault.Desktop.Views.RepositoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repository Settings &amp; Contributors"
        Width="560"
        Height="580"
        MinWidth="500"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblHeader"
                           Grid.Row="0"
                           Text="Repository Settings"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Repository Title"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="TxtTitle"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Description"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="TxtDescription"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="8"
                             Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkHasDeadline"
                                  Grid.Column="0"
                                  Content="Deadline:"
                                  VerticalAlignment="Center"
                                  Checked="ChkHasDeadline_Changed"
                                  Unchecked="ChkHasDeadline_Changed" />
                        <DatePicker x:Name="DpDeadline"
                                    Grid.Column="2" />
                        <CheckBox x:Name="ChkIsLocked"
                                  Grid.Column="4"
                                  Content="Lock Repository"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- contributors management -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BgCanvasBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Repository Contributors"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6" />

                        <DataGrid x:Name="GridContributors"
                                  Grid.Row="1"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="105" />
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding TeamRole}" Width="95" />
                                <DataGridTextColumn Header="Access" Binding="{Binding AccessLevel}" Width="115" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboAddStudent"
                                      Grid.Column="0" />
                            <Button x:Name="BtnAssignStudent"
                                    Grid.Column="2"
                                    Content="+ Assign"
                                    Padding="10,4"
                                    Click="BtnAssignStudent_Click" />
                            <Button x:Name="BtnRemoveSelected"
                                    Grid.Column="4"
                                    Content="Remove Selected"
                                    Padding="10,4"
                                    Click="BtnRemoveSelected_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ErrorBanner"
                        Grid.Row="3"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource AccentDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LblError"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            Width="95"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click" />
                    <Button x:Name="BtnSave"
                            Content="Save Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="130"
                            IsDefault="True"
                            Click="BtnSave_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
