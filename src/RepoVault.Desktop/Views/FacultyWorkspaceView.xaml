<UserControl x:Class="RepoVault.Desktop.Views.FacultyWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgCanvasBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI"
             Loaded="UserControl_Loaded">
    <Grid>
        <!-- ======================================================================= -->
        <!-- TOP-LEVEL FACULTY PAGES (Controlled by Left Sidebar)                    -->
        <!-- ======================================================================= -->
        <Grid x:Name="TopLevelPagesRoot" Margin="12" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- shared top page header with single sidebar toggle (hidden when sidebar is open) and active course selector -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,0"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPageSidebarToggle"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                ToolTip="Toggle Navigation Sidebar (Ctrl+B)"
                                Click="BtnToggleSidebar_Click">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconSidebarToggle}" />
                        </Button>
                        <TextBlock x:Name="LblActivePageTitle"
                                   Text="Courses &amp; Tasks"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Course:"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <ComboBox x:Name="CboActiveCourse"
                                  Width="250"
                                  Margin="0,0,6,0"
                                  SelectionChanged="CboActiveCourse_SelectionChanged" />
                        <Button x:Name="BtnRefreshCourse"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Refresh Course Data"
                                Click="BtnRefreshCourse_Click">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconRefresh}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAGE 1: COURSES & TASKS -->
            <Grid x:Name="PageCoursesTasksGrid" Grid.Row="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- left: courses list and crud -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="COURSES"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button x:Name="BtnNewCourse"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="9,4"
                                    Margin="0,0,6,0"
                                    Click="BtnNewCourse_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconPathStyle}"
                                          Data="{StaticResource IconPlus}"
                                          Width="11" Height="11"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text="New Course" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEditCourse"
                                    Content="Edit"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    Click="BtnEditCourse_Click" />
                            <Button x:Name="BtnDeleteCourse"
                                    Content="Delete"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,4"
                                    Click="BtnDeleteCourse_Click" />
                        </WrapPanel>

                        <DataGrid x:Name="GridCourses"
                                  Grid.Row="2"
                                  SelectionChanged="GridCourses_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding CourseCode}" Width="80" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="*" />
                                <DataGridTextColumn Header="Sem" Binding="{Binding Semester}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- right: coding tasks for selected course -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblSelectedCourseHeader"
                                           Text="Select a Course"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="LblSelectedCourseSub"
                                           Text="Coding tasks assigned to students in this course"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Button x:Name="BtnPostNewCodingTask"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="11,4"
                                    VerticalAlignment="Center"
                                    Click="BtnPostNewCodingTask_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconPathStyle}"
                                          Data="{StaticResource IconPlus}"
                                          Width="11" Height="11"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text="Post Coding Task" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="GridCodingTasks" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding TaskId}" Width="50" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Task Title" Binding="{Binding Title}" Width="1.4*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Starter Template" Binding="{Binding StarterTemplate}" Width="135" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding ModeText}" Width="130" />
                                <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineText}" Width="145" FontFamily="Consolas" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- PAGE 2: STUDENT SUBMISSIONS -->
            <Border x:Name="PageSubmissionsBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Double-click any student repository (or right-click for actions) to inspect code and grade the rubric."
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnMoveToRepoBin"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,8,0"
                                    Click="BtnMoveToRepoBin_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconPathStyle}"
                                          Data="{StaticResource IconTrash}"
                                          Width="12" Height="12"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text="Move to Repo Bin" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnInspectSelectedSubmission"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="11,4"
                                    Click="BtnInspectSelectedSubmission_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Inspect &amp; Grade" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Path Style="{StaticResource VectorIconPathStyle}"
                                          Data="{StaticResource IconArrowRight}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="GridSubmissions"
                              Grid.Row="1"
                              MouseDoubleClick="GridSubmissions_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Inspect Code" Click="MenuInspectSubmission_Click" />
                                <MenuItem Header="Grade Rubric..." Click="MenuGradeSubmission_Click" />
                                <MenuItem Header="Lock / Unlock Repository" Click="MenuLockUnlockSubmission_Click" />
                                <MenuItem Header="Copy Clone Command" Click="MenuCopySubmissionClone_Click" />
                                <MenuItem Header="Move to Repo Bin" Click="MenuMoveSubmissionToBin_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Repository" Binding="{Binding RepoSlug}" Width="140" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*" />
                            <DataGridTextColumn Header="Student Owner" Binding="{Binding OwnerText}" Width="*" />
                            <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedText}" Width="145" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Timeliness" Binding="{Binding DeadlineStatus}" Width="105" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Rubric Score" Binding="{Binding TotalScoreText}" Width="105" FontFamily="Consolas" FontWeight="Bold" />
                            <DataGridTextColumn Header="Lock State" Binding="{Binding LockedText}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PAGE 3: GROUPMATE TICKETS -->
            <Border x:Name="PageTicketsBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblPendingTicketsAlert"
                                   Grid.Column="0"
                                   Text="Select a GroupCollaborator ticket below to approve or reject write access."
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnApproveTicket"
                                    Content="Approve Ticket"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="12,4"
                                    Margin="0,0,8,0"
                                    Click="BtnApproveTicket_Click" />
                            <Button x:Name="BtnRejectTicket"
                                    Content="Reject Ticket"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,4"
                                    Click="BtnRejectTicket_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="GridTickets"
                              Grid.Row="1"
                              Margin="0,0,0,10"
                              SelectionChanged="GridTickets_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Repository" Binding="{Binding RepoSlug}" Width="135" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Owner (Requested By)" Binding="{Binding OwnerDisplay}" Width="*" />
                            <DataGridTextColumn Header="Invited User" Binding="{Binding StudentDisplay}" Width="1.2*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Team Role" Binding="{Binding TeamRole}" Width="120" />
                            <DataGridTextColumn Header="Access Level" Binding="{Binding AccessLevel}" Width="140" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Ticket Status" Binding="{Binding ApprovalStatus}" Width="115" FontWeight="Bold" />
                            <DataGridTextColumn Header="Assigned At" Binding="{Binding AssignedAtText}" Width="145" FontFamily="Consolas" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Expander Grid.Row="2"
                              Header="Selected Ticket Details"
                              IsExpanded="True">
                        <StackPanel Margin="4">
                            <TextBlock x:Name="LblFacultyTicketDetailHeader"
                                       Text="Select a row above to inspect ticket ownership, target student, and access permissions."
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="LblFacultyTicketDetailParties"
                                       Text=""
                                       FontSize="12"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="LblFacultyTicketDetailAccess"
                                       Text=""
                                       FontSize="12"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <!-- PAGE 4: REPO BIN -->
            <Border x:Name="PageTrashBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Soft-deleted repositories in the Repo Bin. Restore to return to active course view, or Purge Permanently to remove from database and disk."
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnRestoreTrashed"
                                    Content="Restore Selected"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="12,4"
                                    Margin="0,0,8,0"
                                    Click="BtnRestoreTrashed_Click" />
                            <Button x:Name="BtnPurgeTrashed"
                                    Content="Purge Permanently"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,4"
                                    Click="BtnPurgeTrashed_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="GridTrashedRepos" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Repo ID" Binding="{Binding RepoId}" Width="80" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Slug" Binding="{Binding RepoSlug}" Width="150" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*" />
                            <DataGridTextColumn Header="Course ID" Binding="{Binding CourseId}" Width="95" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Trashed At (UTC)" Binding="{Binding TrashedAt}" Width="165" FontFamily="Consolas" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================================= -->
        <!-- DEDICATED FACULTY INSPECTION & GRADING VIEW (VS Code 3-Zone + Drawer)   -->
        <!-- ======================================================================= -->
        <Grid x:Name="DedicatedInspectorGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ZONE A: COMPACT 36PX TOP HEADER BAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- left: [IconSidebarToggle (when sidebar collapsed)] + [IconArrowLeft] + repo slug + subtle lock icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnWorkspaceSidebarToggle"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,4,0"
                                ToolTip="Toggle Navigation Sidebar (Ctrl+B)"
                                Click="BtnToggleSidebar_Click">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconSidebarToggle}" />
                        </Button>

                        <Button x:Name="BtnBackToSubmissions"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Back to Submissions"
                                Click="BtnBackToSubmissions_Click">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconArrowLeft}" />
                        </Button>

                        <Path Style="{StaticResource MutedVectorIconPathStyle}"
                              Data="{StaticResource IconGitBranch}"
                              Margin="0,0,6,0" />

                        <TextBlock x:Name="LblInspectorSlugTitle"
                                   Text="repo-slug"
                                   FontFamily="Consolas"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <Path x:Name="HeaderLockIcon"
                              Style="{StaticResource MutedVectorIconPathStyle}"
                              Data="{StaticResource IconLock}"
                              Margin="8,0,0,0"
                              Visibility="Collapsed"
                              ToolTip="Repository is locked" />
                    </StackPanel>

                    <!-- right: [IconExplorerToggle] + [IconBottomPanelToggle] + [IconCopy + Clone] + [IconLock] + [Grade Rubric] -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleExplorer"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,4,0"
                                ToolTip="Toggle Explorer"
                                Click="BtnToggleExplorer_Click">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconExplorerToggle}" />
                        </Button>

                        <Button x:Name="BtnToggleBottomPanel"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Toggle Bottom Panel (Ctrl+J)"
                                Click="BtnToggleBottomPanel_Click">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconBottomPanelToggle}" />
                        </Button>

                        <Button x:Name="BtnCopyCloneUrl"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="Copy git clone command"
                                Click="BtnCopyCloneUrl_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="CloneBtnIconPath"
                                      Style="{StaticResource VectorIconPathStyle}"
                                      Data="{StaticResource IconCopy}"
                                      Width="12" Height="12"
                                      Margin="0,0,5,0" />
                                <TextBlock x:Name="LblCloneBtnText"
                                           Text="Clone"
                                           FontSize="11.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLockUnlockRepo"
                                Style="{StaticResource IconButtonStyle}"
                                Padding="6,4"
                                Margin="0,0,6,0"
                                ToolTip="Lock / Unlock Repository"
                                Click="BtnLockUnlockRepo_Click">
                            <Path x:Name="LockToggleIconPath"
                                  Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconLock}" />
                        </Button>

                        <Button x:Name="BtnGradeRubric"
                                Content="Grade Rubric"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,3"
                                FontSize="11.5"
                                Click="BtnGradeRubric_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MIDDLE ROW: ZONE B (LEFT FILE EXPLORER) + ZONE C (CENTER CODE VIEWER) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ZONE B: LEFT FILE EXPLORER PANE (210px wide, collapsible) -->
                <Border x:Name="InspectorExplorerBorder"
                        Grid.Column="0"
                        Width="210"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="10,0"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="EXPLORER"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        <TreeView x:Name="TvInspectorFiles"
                                  Grid.Row="1"
                                  Padding="4"
                                  SelectedItemChanged="TvInspectorFiles_SelectedItemChanged" />
                    </Grid>
                </Border>

                <!-- ZONE C: CENTER CODE VIEWER PANE -->
                <Grid Grid.Column="1" Background="{DynamicResource BgCanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- compact 32px editor tab header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblInspectorFileIcon"
                                       Text="&#xF15B;"
                                       FontFamily="{StaticResource NerdFontFamily}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock x:Name="LblInspectorFilePath"
                                       Text="No file selected"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Path Style="{StaticResource MutedVectorIconPathStyle}"
                                  Data="{StaticResource IconLock}"
                                  Margin="8,0,0,0"
                                  ToolTip="Read-Only Mode" />
                        </StackPanel>
                    </Border>

                    <!-- full-bleed consolas code viewer -->
                    <TextBox x:Name="TxtInspectorCode"
                             Grid.Row="1"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="13"
                             Padding="14,12"
                             BorderThickness="0"
                             Background="{DynamicResource BgCanvasBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextWrapping="NoWrap" />
                </Grid>
            </Grid>

            <!-- ZONE D: TOGGLEABLE BOTTOM PANEL (220px tall when open, Ctrl+J) -->
            <Border x:Name="BottomPanelBorder"
                    Grid.Row="2"
                    Height="220"
                    Visibility="Visible"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- bottom panel tab bar + [IconChevronDown] close button -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnInspPanelTabSpec"
                                        Content="Task Spec"
                                        Style="{StaticResource BottomPanelTabButtonStyle}"
                                        Margin="0,0,4,0"
                                        Click="BtnInspPanelTabSpec_Click" />
                                <Button x:Name="BtnInspPanelTabCommits"
                                        Content="Commits &amp; Pushes"
                                        Style="{StaticResource BottomPanelTabButtonStyle}"
                                        Margin="0,0,4,0"
                                        Click="BtnInspPanelTabCommits_Click" />
                                <Button x:Name="BtnInspPanelTabDiscussions"
                                        Content="Discussions"
                                        Style="{StaticResource BottomPanelTabButtonStyle}"
                                        Margin="0,0,4,0"
                                        Click="BtnInspPanelTabDiscussions_Click" />
                                <Button x:Name="BtnInspPanelTabTeam"
                                        Content="Team &amp; Access"
                                        Style="{StaticResource BottomPanelTabButtonStyle}"
                                        Margin="0,0,4,0"
                                        Click="BtnInspPanelTabTeam_Click" />
                                <Button x:Name="BtnInspPanelTabRubric"
                                        Content="Rubric &amp; Metrics"
                                        Style="{StaticResource BottomPanelTabButtonStyle}"
                                        Click="BtnInspPanelTabRubric_Click" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Padding="4,2"
                                    ToolTip="Close Panel (Ctrl+J)"
                                    Click="BtnToggleBottomPanel_Click">
                                <Path Style="{StaticResource MutedVectorIconPathStyle}"
                                      Data="{StaticResource IconChevronDown}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- bottom panel tab contents -->
                    <Grid Grid.Row="1" Margin="8,6">
                        <!-- TAB 0: TASK PROBLEM SPEC -->
                        <Grid x:Name="InspPanelTaskSpecGrid" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="LblInspSpecTitle" Text="Task Title" FontSize="11.5" FontWeight="Bold" />
                                </Border>
                                <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="LblInspSpecCourse" Text="Course: --" FontSize="11" FontFamily="Consolas" />
                                </Border>
                                <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="LblInspSpecTemplate" Text="Template: --" FontSize="11" FontFamily="Consolas" />
                                </Border>
                                <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="LblInspSpecMode" Text="Mode: --" FontSize="11" FontFamily="Consolas" />
                                </Border>
                                <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,0,4">
                                    <TextBlock x:Name="LblInspSpecDeadline" Text="Deadline: --" FontSize="11" FontFamily="Consolas" />
                                </Border>
                            </WrapPanel>

                            <TextBox x:Name="TxtInspSpecInstructions"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     FontSize="12"
                                     Padding="8,6"
                                     Background="{DynamicResource BgCanvasBrush}" />
                        </Grid>

                        <!-- TAB 1: COMMITS & PUSHES (unified table) -->
                        <DataGrid x:Name="GridInspectorUnifiedCommits" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SHA" Binding="{Binding ShortSha}" Width="85" FontFamily="Consolas" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Commit Message" Binding="{Binding CommitMessage}" Width="1.4*" />
                                <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="150" />
                                <DataGridTextColumn Header="Server Push Timestamp" Binding="{Binding TimestampText}" Width="155" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Timeliness" Binding="{Binding TimelinessText}" Width="100" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- TAB 2: DISCUSSIONS -->
                        <Grid x:Name="InspPanelDiscussionsGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="GridInspectorDiscussions" Grid.Row="0" Margin="0,0,0,6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Author" Binding="{Binding AuthorFullName}" Width="160" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Role" Binding="{Binding AuthorRole}" Width="85" />
                                    <DataGridTextColumn Header="Comment" Binding="{Binding CommentBody}" Width="1.4*" />
                                    <DataGridTextColumn Header="Visibility" Binding="{Binding VisibilityText}" Width="90" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Posted" Binding="{Binding CreatedAtText}" Width="145" FontFamily="Consolas" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFacultyComment"
                                         Grid.Column="0"
                                         FontSize="12"
                                         Padding="6,3"
                                         Margin="0,0,6,0"
                                         ToolTip="Post faculty feedback..." />
                                <Button x:Name="BtnReplyFacultyComment"
                                        Grid.Column="1"
                                        Content="Reply (@User)"
                                        Padding="10,3"
                                        FontSize="11.5"
                                        Margin="0,0,6,0"
                                        ToolTip="Insert @mention for the selected comment author"
                                        Click="BtnReplyFacultyComment_Click" />
                                <Button x:Name="BtnPostFacultyComment"
                                        Grid.Column="2"
                                        Content="Post"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="10,3"
                                        FontSize="11.5"
                                        Margin="0,0,6,0"
                                        Click="BtnPostFacultyComment_Click" />
                                <Button x:Name="BtnToggleHideComment"
                                        Grid.Column="3"
                                        Content="Moderate (Hide/Unhide)"
                                        Padding="10,3"
                                        FontSize="11.5"
                                        ToolTip="Toggle visibility of selected comment for students"
                                        Click="BtnToggleHideComment_Click" />
                            </Grid>
                        </Grid>

                        <!-- TAB 3: TEAM & ACCESS -->
                        <Grid x:Name="InspPanelTeamGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <Button x:Name="BtnInspApproveTicket"
                                        Content="Approve"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Padding="8,2"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        Click="BtnInspApproveTicket_Click" />
                                <Button x:Name="BtnInspRejectTicket"
                                        Content="Reject"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="8,2"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        Click="BtnInspRejectTicket_Click" />
                                <Button x:Name="BtnEditRepo"
                                        Content="Manage Repo..."
                                        Padding="8,2"
                                        FontSize="11"
                                        Click="BtnEditRepo_Click" />
                            </StackPanel>

                            <DataGrid x:Name="GridInspectorTeam"
                                      Grid.Row="1"
                                      SelectionChanged="GridInspectorTeam_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Student" Binding="{Binding FullName}" Width="180" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="125" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Role" Binding="{Binding TeamRole}" Width="130" />
                                    <DataGridTextColumn Header="Access Level" Binding="{Binding AccessLevel}" Width="145" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding ApprovalStatus}" Width="*" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- TAB 4: RUBRIC & METRICS -->
                        <Grid x:Name="InspPanelRubricGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- left: rubric scores + critique notes -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,4">
                                        <TextBlock x:Name="LblInspEvalTotalScore" Text="Total: -- / 100" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" />
                                    </Border>
                                    <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblInspScoreArch" Text="Arch: 0/25" FontSize="11" FontFamily="Consolas" />
                                    </Border>
                                    <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblInspScoreFunc" Text="Func: 0/25" FontSize="11" FontFamily="Consolas" />
                                    </Border>
                                    <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblInspScoreQual" Text="Qual: 0/25" FontSize="11" FontFamily="Consolas" />
                                    </Border>
                                    <Border Background="{DynamicResource BgCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,0,4">
                                        <TextBlock x:Name="LblInspScoreDoc" Text="Doc: 0/25" FontSize="11" FontFamily="Consolas" />
                                    </Border>
                                </WrapPanel>

                                <TextBox x:Name="TxtInspEvalNotes"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         FontSize="11.5"
                                         Padding="6,4"
                                         Background="{DynamicResource BgCanvasBrush}" />
                            </Grid>

                            <!-- right: compact loc & language breakdown -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblInspMetricSummaryLine"
                                           Grid.Row="0"
                                           Text="0 Files  |  0 Source LOC  |  0 Comments  |  0 Blanks"
                                           FontSize="11.5"
                                           FontFamily="Consolas"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />

                                <DataGrid x:Name="GridInspectorLanguages" Grid.Row="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Language" Binding="{Binding LanguageName}" Width="*" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="55" FontFamily="Consolas" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceLines}" Width="65" FontFamily="Consolas" />
                                        <DataGridTextColumn Header="Comments" Binding="{Binding CommentLines}" Width="75" FontFamily="Consolas" />
                                        <DataGridTextColumn Header="Share" Binding="{Binding ShareText}" Width="65" FontFamily="Consolas" FontWeight="Bold" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
