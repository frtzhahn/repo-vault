<UserControl x:Class="RepoVault.Desktop.Views.FacultyWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgCanvasBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- left column: course catalog sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,10">
                    <TextBlock Text="Courses"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnNewCourse"
                            Content="+ New Course"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            Click="BtnNewCourse_Click" />
                </Grid>

                <DataGrid x:Name="GridCourses"
                          Grid.Row="1"
                          Margin="0,0,0,10"
                          SelectionChanged="GridCourses_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding CourseCode}" Width="68" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="*" />
                        <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="88" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnEditCourse"
                            Grid.Column="0"
                            Content="Edit Course"
                            Padding="8,5"
                            Click="BtnEditCourse_Click" />
                    <Button x:Name="BtnDeleteCourse"
                            Grid.Column="2"
                            Content="Delete Course"
                            Padding="8,5"
                            Click="BtnDeleteCourse_Click" />
                </Grid>

                <Button x:Name="BtnOpenRepoBin"
                        Grid.Row="3"
                        Content="Open Repo Bin (Trash)"
                        Style="{StaticResource WarningButtonStyle}"
                        Height="32"
                        Click="BtnOpenRepoBin_Click" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="12"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- right column: course classroom and submission workstation -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" MinHeight="220" />
            </Grid.RowDefinitions>

            <!-- row 0: course header and pending ticket alert strip -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,8">
                <Border Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="LblSelectedCourseHeader"
                                       Text="Select a Course"
                                       FontSize="17"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="LblSelectedCourseSub"
                                       Text="Department &amp; Semester"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button x:Name="BtnRefreshCourse"
                                Content="Refresh Classroom"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="12,5"
                                Click="BtnRefreshCourse_Click" />
                    </Grid>
                </Border>

                <!-- gruvbox ochre pending ticket alert bar -->
                <Border x:Name="PendingTicketsAlertBar"
                        Background="{DynamicResource AccentWarningBrush}"
                        CornerRadius="6"
                        Padding="14,7"
                        Margin="0,6,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="LblPendingTicketsAlert"
                                   Text="Pending Groupmate Collaboration Tickets require your review."
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentBrush}" />
                        <Button x:Name="BtnViewApproveTickets"
                                Content="View / Approve Tickets"
                                HorizontalAlignment="Right"
                                Padding="10,3"
                                Click="BtnViewApproveTickets_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- row 1: upper course tabs (3 tabs) -->
            <TabControl x:Name="TabCourseUpper"
                        Grid.Row="1">
                <!-- tab 1: student submissions -->
                <TabItem x:Name="TabSubmissions"
                         Header="Student Submissions">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- submission action toolbar -->
                        <WrapPanel Grid.Row="0"
                                   Orientation="Horizontal"
                                   Margin="0,0,0,8">
                            <Button x:Name="BtnGradeRubric"
                                    Content="Grade Rubric..."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    Click="BtnGradeRubric_Click" />
                            <Button x:Name="BtnLockUnlockRepo"
                                    Content="Lock / Unlock Repo"
                                    Padding="11,5"
                                    Margin="0,0,6,0"
                                    Click="BtnLockUnlockRepo_Click" />
                            <Button x:Name="BtnEditRepo"
                                    Content="Edit Repo"
                                    Padding="11,5"
                                    Margin="0,0,6,0"
                                    Click="BtnEditRepo_Click" />
                            <Button x:Name="BtnMoveToRepoBin"
                                    Content="Move to Repo Bin"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="11,5"
                                    Margin="0,0,6,0"
                                    Click="BtnMoveToRepoBin_Click" />
                            <Button x:Name="BtnCopyCloneUrl"
                                    Content="Copy Clone URL"
                                    Padding="11,5"
                                    Click="BtnCopyCloneUrl_Click" />
                        </WrapPanel>

                        <DataGrid x:Name="GridSubmissions"
                                  Grid.Row="1"
                                  SelectionChanged="GridSubmissions_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RepoSlug" Binding="{Binding RepoSlug}" Width="135" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerText}" Width="115" />
                                <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedText}" Width="105" />
                                <DataGridTextColumn Header="Deadline Status" Binding="{Binding DeadlineStatus}" Width="110" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Total Score" Binding="{Binding TotalScoreText}" Width="90" FontWeight="Bold" />
                                <DataGridTextColumn Header="Locked" Binding="{Binding LockedText}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- tab 2: coding tasks -->
                <TabItem x:Name="TabCodingTasks"
                         Header="Coding Tasks">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button x:Name="BtnPostNewCodingTask"
                                    Content="+ Post New Coding Task"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,5"
                                    Click="BtnPostNewCodingTask_Click" />
                        </StackPanel>

                        <DataGrid x:Name="GridCodingTasks"
                                  Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Template" Binding="{Binding StarterTemplate}" Width="95" />
                                <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineText}" Width="140" />
                                <DataGridTextColumn Header="Solo / Group" Binding="{Binding ModeText}" Width="95" />
                                <DataGridTextColumn Header="Max Group Size" Binding="{Binding MaxGroupSize}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- tab 3: groupmate tickets -->
                <TabItem x:Name="TabGroupmateTickets"
                         Header="Groupmate Tickets">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button x:Name="BtnApproveTicket"
                                    Content="Approve Ticket"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="12,5"
                                    Margin="0,0,8,0"
                                    Click="BtnApproveTicket_Click" />
                            <Button x:Name="BtnRejectTicket"
                                    Content="Reject Ticket"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,5"
                                    Click="BtnRejectTicket_Click" />
                        </StackPanel>

                        <DataGrid x:Name="GridTickets"
                                  Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Repo" Binding="{Binding RepoSlug}" Width="130" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentDisplay}" Width="*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding TeamRole}" Width="110" />
                                <DataGridTextColumn Header="AccessLevel" Binding="{Binding AccessLevel}" Width="130" />
                                <DataGridTextColumn Header="ApprovalStatus" Binding="{Binding ApprovalStatus}" Width="115" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="2"
                          Height="10"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- row 2: lower read-only submission inspector (4 sub-tabs) -->
            <Border Grid.Row="3"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LblInspectorHeader"
                               Grid.Row="0"
                               Text="Read-Only Submission Inspector - Select a repository above"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="4,0,0,6" />

                    <TabControl Grid.Row="1">
                        <!-- sub-tab 1: files and code (read-only) -->
                        <TabItem Header="Files &amp; Code (Read-Only)">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" MinWidth="150" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TreeView x:Name="TvInspectorFiles"
                                          Grid.Column="0"
                                          SelectedItemChanged="TvInspectorFiles_SelectedItemChanged" />

                                <GridSplitter Grid.Column="1"
                                              Width="8"
                                              HorizontalAlignment="Stretch"
                                              Background="Transparent" />

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource BgElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1,1,1,0"
                                            Padding="10,4">
                                        <Grid>
                                            <TextBlock x:Name="LblInspectorFilePath"
                                                       Text="No file selected"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="LblInspectorFileSize"
                                                       Text=""
                                                       FontFamily="Consolas"
                                                       FontSize="11.5"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Border>
                                    <TextBox x:Name="TxtInspectorCode"
                                             Grid.Row="1"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             Padding="10"
                                             Background="{DynamicResource BgCanvasBrush}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- sub-tab 2: commits and push ledger -->
                        <TabItem Header="Commits &amp; Push Ledger">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DataGrid x:Name="GridInspectorCommits"
                                          Grid.Column="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SHA" Binding="{Binding ShortSha}" Width="80" FontFamily="Consolas" />
                                        <DataGridTextColumn Header="Commit Message" Binding="{Binding CommitMessage}" Width="*" />
                                        <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="105" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding CommittedAtText}" Width="125" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Column="1"
                                              Width="8"
                                              HorizontalAlignment="Stretch"
                                              Background="Transparent" />

                                <DataGrid x:Name="GridInspectorPushes"
                                          Grid.Column="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Push #" Binding="{Binding PushId}" Width="55" />
                                        <DataGridTextColumn Header="Branch" Binding="{Binding BranchRef}" Width="80" />
                                        <DataGridTextColumn Header="New SHA" Binding="{Binding NewShortSha}" Width="80" FontFamily="Consolas" />
                                        <DataGridTextColumn Header="Pusher" Binding="{Binding PusherFullName}" Width="*" />
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding PushedAtText}" Width="125" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- sub-tab 3: code metrics -->
                        <TabItem Header="Code Metrics">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource BgCanvasBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblInspFiles" Text="Total Files: 0" FontWeight="SemiBold" Margin="0,0,22,0" />
                                        <TextBlock x:Name="LblInspSloc" Text="Source LOC: 0" FontWeight="SemiBold" Margin="0,0,22,0" />
                                        <TextBlock x:Name="LblInspComments" Text="Comment LOC: 0" FontWeight="SemiBold" Margin="0,0,22,0" />
                                        <TextBlock x:Name="LblInspBlanks" Text="Blank LOC: 0" FontWeight="SemiBold" Margin="0,0,22,0" />
                                        <TextBlock x:Name="LblInspPrimaryLang" Text="Primary Language: None" FontWeight="SemiBold" />
                                    </WrapPanel>
                                </Border>

                                <DataGrid x:Name="GridInspectorLanguages"
                                          Grid.Row="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Language" Binding="{Binding LanguageName}" Width="140" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="80" />
                                        <DataGridTextColumn Header="Source Lines" Binding="{Binding SourceLines}" Width="110" />
                                        <DataGridTextColumn Header="Comment Lines" Binding="{Binding CommentLines}" Width="110" />
                                        <DataGridTextColumn Header="Blank Lines" Binding="{Binding BlankLines}" Width="100" />
                                        <DataGridTextColumn Header="Share" Binding="{Binding ShareText}" Width="*" FontWeight="Bold" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- sub-tab 4: discussions and moderation -->
                        <TabItem Header="Discussions &amp; Moderation">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="GridInspectorDiscussions"
                                          Grid.Row="0"
                                          Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Author" Binding="{Binding AuthorFullName}" Width="140" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding AuthorRole}" Width="75" />
                                        <DataGridTextColumn Header="Comment" Binding="{Binding CommentBody}" Width="*" />
                                        <DataGridTextColumn Header="Visibility" Binding="{Binding VisibilityText}" Width="85" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Posted At" Binding="{Binding CreatedAtText}" Width="135" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtFacultyComment"
                                             Grid.Column="0" />
                                    <Button x:Name="BtnPostFacultyComment"
                                            Grid.Column="2"
                                            Content="Post Feedback"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,5"
                                            Click="BtnPostFacultyComment_Click" />
                                    <Button x:Name="BtnToggleHideComment"
                                            Grid.Column="4"
                                            Content="Hide / Unhide Comment"
                                            Padding="12,5"
                                            Click="BtnToggleHideComment_Click" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
