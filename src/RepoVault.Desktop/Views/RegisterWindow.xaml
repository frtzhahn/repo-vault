<Window x:Class="RepoVault.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Student Account"
        Width="480"
        Height="590"
        MinWidth="420"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24,20"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Create Student Account"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Register your classroom account to start coding tasks and push repositories."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,16" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Student ID Number"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="TxtIdNumber" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Username"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="TxtUsername" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Full Name"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtFullName"
                         Margin="0,0,0,10" />

                <TextBlock Text="Academic Email"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtEmail"
                         Margin="0,0,0,10" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Password"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <PasswordBox x:Name="TxtPassword" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirm Password"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <PasswordBox x:Name="TxtConfirmPassword" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="8+ characters with at least one digit and one symbol"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,14" />

                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource AccentDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,7"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LblError"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            Width="95"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click" />
                    <Button x:Name="BtnRegister"
                            Content="Register"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="120"
                            IsDefault="True"
                            Click="BtnRegister_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
