<Window x:Class="RepoVault.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repo Vault - Classroom Workstation"
        Width="1360"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- row 0: top action and server bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- left: app title + role badge pill -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Repo Vault"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border x:Name="RoleBadgeBorder"
                            Background="{DynamicResource AccentBadgeBrush}"
                            CornerRadius="10"
                            Padding="10,3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LblRoleBadge"
                                   Text="STUDENT WORKSTATION"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextOnAccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- center: live git http server control group -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgCanvasBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,5"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot"
                                     Width="9"
                                     Height="9"
                                     Fill="{DynamicResource AccentDangerBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0" />
                            <TextBlock x:Name="LblServerStatus"
                                       Text="Git Server: Stopped"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnServerToggle"
                            Content="Start Git Server"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="11,5"
                            Margin="0,0,6,0"
                            Click="BtnServerToggle_Click" />

                    <Button x:Name="BtnCopyCloneBase"
                            Content="Copy Clone Base"
                            Padding="10,5"
                            Margin="0,0,8,0"
                            Click="BtnCopyCloneBase_Click" />

                    <Border Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LblPushCounter"
                                   Text="Pushes Received: 0"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- right: seed, theme toggle, user label, logout -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnSeedDemo"
                            Content="Seed / Re-index Demo"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Click="BtnSeedDemo_Click" />

                    <Button x:Name="BtnThemeToggle"
                            Content="Theme: Light"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            Click="BtnThemeToggle_Click" />

                    <TextBlock x:Name="LblLoggedInUser"
                               Text="User"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Button x:Name="BtnLogout"
                            Content="Logout"
                            Padding="10,5"
                            Click="BtnLogout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- row 1: main content host -->
        <ContentControl x:Name="WorkspaceHost"
                        Grid.Row="1"
                        Margin="12" />

        <!-- row 2: bottom status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblStatusBar"
                           Grid.Column="0"
                           Text="Ready."
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock x:Name="LblLanInfo"
                           Grid.Column="1"
                           Text="LAN IPv4: 127.0.0.1"
                           FontSize="11.5"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
