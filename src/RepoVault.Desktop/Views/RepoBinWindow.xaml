<Window x:Class="RepoVault.Desktop.Views.RepoBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repository Bin (Trash Manager)"
        Width="720"
        Height="460"
        MinWidth="600"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">
                    <TextBlock Text="Repository Bin (Soft-Deleted Repositories)"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Text="Restore trashed repositories to active status or permanently purge bare Git repositories and MariaDB records."
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <DataGrid x:Name="GridTrashedRepos"
                          Grid.Row="1"
                          Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slug" Binding="{Binding RepoSlug}" Width="140" FontFamily="Consolas" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Language" Binding="{Binding PrimaryLang}" Width="90" />
                        <DataGridTextColumn Header="Files" Binding="{Binding TotalFiles}" Width="65" />
                        <DataGridTextColumn Header="Source LOC" Binding="{Binding SourceLines}" Width="90" />
                        <DataGridTextColumn Header="Trashed At" Binding="{Binding TrashedAtText}" Width="135" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button x:Name="BtnRestoreSelected"
                                Content="Restore Selected"
                                Style="{StaticResource SuccessButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                Click="BtnRestoreSelected_Click" />
                        <Button x:Name="BtnPurgePermanently"
                                Content="Purge Permanently"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="14,6"
                                Click="BtnPurgePermanently_Click" />
                    </StackPanel>

                    <Button x:Name="BtnClose"
                            Content="Close"
                            Width="95"
                            HorizontalAlignment="Right"
                            IsCancel="True"
                            Click="BtnClose_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
