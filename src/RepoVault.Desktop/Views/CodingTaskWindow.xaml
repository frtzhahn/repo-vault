<Window x:Class="RepoVault.Desktop.Views.CodingTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Post New Coding Task"
        Width="500"
        Height="530"
        MinWidth="440"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
            <StackPanel>
                <TextBlock x:Name="LblHeader"
                           Text="Post New Coding Task"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />

                <TextBlock Text="Task Title"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtTitle"
                         Margin="0,0,0,10" />

                <TextBlock Text="Starter Template &amp; Instructions"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ComboBox x:Name="CboStarterTemplate"
                          SelectedIndex="0"
                          Margin="0,0,0,10">
                    <ComboBoxItem Content="csharp" />
                    <ComboBoxItem Content="java" />
                    <ComboBoxItem Content="c" />
                    <ComboBoxItem Content="javascript" />
                </ComboBox>

                <TextBox x:Name="TxtInstructions"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="95"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="8"
                         Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkHasDeadline"
                              Grid.Column="0"
                              Content="Enforce Deadline:"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="ChkHasDeadline_Changed"
                              Unchecked="ChkHasDeadline_Changed" />
                    <DatePicker x:Name="DpDeadline"
                                Grid.Column="2" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkAllowGroupWork"
                              Grid.Column="0"
                              Content="Allow Group Work (requires ticket approval)"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Checked="ChkAllowGroupWork_Changed"
                              Unchecked="ChkAllowGroupWork_Changed" />
                    <TextBlock Grid.Column="1"
                               Text="Max Size:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,6,0" />
                    <ComboBox x:Name="CboMaxGroupSize"
                              Grid.Column="2"
                              SelectedIndex="0"
                              IsEnabled="False">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" />
                    </ComboBox>
                </Grid>

                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource AccentDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LblError"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            Width="90"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click" />
                    <Button x:Name="BtnCreate"
                            Content="Post Task"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="125"
                            IsDefault="True"
                            Click="BtnCreate_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
