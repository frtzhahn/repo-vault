<Window x:Class="RepoVault.Desktop.Views.CourseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course Editor"
        Width="460"
        Height="430"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
            <StackPanel>
                <TextBlock x:Name="LblHeader"
                           Text="Create Course"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,14" />

                <TextBlock Text="Course Code (e.g. CS201)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtCourseCode"
                         Margin="0,0,0,10" />

                <TextBlock Text="Course Title"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtCourseTitle"
                         Margin="0,0,0,10" />

                <TextBlock Text="Department"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtDepartment"
                         Text="Computer Studies Department"
                         Margin="0,0,0,10" />

                <TextBlock Text="Semester"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtSemester"
                         Text="2nd Sem AY 2025-2026"
                         Margin="0,0,0,12" />

                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource AccentDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LblError"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            Width="90"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click" />
                    <Button x:Name="BtnSave"
                            Content="Save Course"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="125"
                            IsDefault="True"
                            Click="BtnSave_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
